menu "Apocalypse Communicator - Wiring"

    menu "Display (I2C OLED)"
        config PIN_I2C_SDA
            int "I2C SDA pin"
            default 8
        config PIN_I2C_SCL
            int "I2C SCL pin"
            default 9
        config OLED_ADDR
            hex "OLED I2C address"
            default 0x3C
        choice OLED_CHIP
            prompt "OLED controller"
            default OLED_SSD1306
            config OLED_SSD1306
                bool "SSD1306 (most 0.96 inch displays)"
            config OLED_SH1106
                bool "SH1106 (most 1.3 inch displays)"
        endchoice
    endmenu

    menu "Buttons (wire button between pin and GND)"
        config PIN_BTN_UP
            int "UP"
            default 4
        config PIN_BTN_DOWN
            int "DOWN"
            default 5
        config PIN_BTN_LEFT
            int "LEFT"
            default 6
        config PIN_BTN_RIGHT
            int "RIGHT"
            default 7
        config PIN_BTN_OK
            int "OK"
            default 15
        config PIN_BTN_BACK
            int "BACK"
            default 16
        config PIN_BTN_MORSE
            int "MORSE key"
            default 17
    endmenu

    menu "LEDs (pin -> 330 ohm -> LED -> GND)"
        config PIN_LED_RED
            int "Red (alert / SOS)"
            default 38
        config PIN_LED_GREEN
            int "Green (receive)"
            default 39
        config PIN_LED_BLUE
            int "Blue (transmit)"
            default 40
        config PIN_LED_WHITE
            int "White (flashlight, use a transistor for bright LEDs)"
            default 41
    endmenu

    menu "Audio"
        config PIN_SPK_BCLK
            int "Speaker amp (MAX98357A) BCLK"
            default 10
        config PIN_SPK_WS
            int "Speaker amp (MAX98357A) LRC"
            default 11
        config PIN_SPK_DIN
            int "Speaker amp (MAX98357A) DIN"
            default 12
        config PIN_MIC_SCK
            int "Microphone (INMP441) SCK"
            default 13
        config PIN_MIC_WS
            int "Microphone (INMP441) WS"
            default 14
        config PIN_MIC_SD
            int "Microphone (INMP441) SD"
            default 18
    endmenu

    menu "Battery"
        config BATTERY_ADC_ENABLE
            bool "Measure battery voltage"
            default y
        config PIN_BATTERY_ADC
            int "Battery divider pin (ADC1, GPIO1-10)"
            default 1
            depends on BATTERY_ADC_ENABLE
        config BATTERY_DIVIDER_X100
            int "Divider ratio x100 (two equal resistors = 200)"
            default 200
            depends on BATTERY_ADC_ENABLE
    endmenu

    menu "LoRa radio (optional SX1276/RFM95 module)"
        config LORA_ENABLE
            bool "I have an SX1276 / RFM95 / Ra-02 LoRa module connected"
            default n
        config LORA_FREQ_KHZ
            int "Frequency in kHz (433175, 868100 or 915000 - check local law)"
            default 433175
            depends on LORA_ENABLE
        config LORA_TX_POWER_DBM
            int "Transmit power dBm (2-17)"
            range 2 17
            default 17
            depends on LORA_ENABLE
        config PIN_LORA_SCK
            int "SCK"
            default 21
            depends on LORA_ENABLE
        config PIN_LORA_MISO
            int "MISO"
            default 47
            depends on LORA_ENABLE
        config PIN_LORA_MOSI
            int "MOSI"
            default 48
            depends on LORA_ENABLE
        config PIN_LORA_NSS
            int "NSS / CS"
            default 42
            depends on LORA_ENABLE
        config PIN_LORA_RST
            int "RESET"
            default 2
            depends on LORA_ENABLE
    endmenu

endmenu
